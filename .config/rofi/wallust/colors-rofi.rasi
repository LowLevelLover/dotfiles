 /* wallust template - colors-rofi */

* {
active-background: #845C2D;
active-foreground: #5A5654;
normal-background: #D3D0CD;
normal-foreground: #5A5654;
urgent-background: #865B28;
urgent-foreground: #5A5654;

alternate-active-background: #504C58;
alternate-active-foreground: #5A5654;
alternate-normal-background: #D3D0CD;
alternate-normal-foreground: #5A5654;
alternate-urgent-background: #D3D0CD;
alternate-urgent-foreground: #5A5654;

