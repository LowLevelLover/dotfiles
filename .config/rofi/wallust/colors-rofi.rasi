 /* wallust template - colors-rofi */

* {
active-background: #3C415A;
active-foreground: #1B1D28;
normal-background: #FFFEF6;
normal-foreground: #1B1D28;
urgent-background: #3C415A;
urgent-foreground: #1B1D28;

alternate-active-background: #705D66;
alternate-active-foreground: #1B1D28;
alternate-normal-background: #FFFEF6;
alternate-normal-foreground: #1B1D28;
alternate-urgent-background: #FFFEF6;
alternate-urgent-foreground: #1B1D28;

selected-active-background: #3C415A;
selected-active-foreground: #1B1D28;
selected-normal-background: #3C415A;
selected-normal-foreground: #1B1D28;
selected-urgent-background: #3C415A;
selected-urgent-foreground: #1B1D28;

background-color: #FFFEF6;
background: rgba(255,255,255,0.9);
foreground: #1B1D28;
border-color: #3C415A;

color0: #FFFEF6;
color1: #95795D;
color2: #844A47;
color3: #54464C;
color4: #2D3144;
color5: #2D3144;
color6: #2D3144;
color7: #1B1D28;
color8: #9D8369;
color9: #C6A17C;
color10: #B0635F;
